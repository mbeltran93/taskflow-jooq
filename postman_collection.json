{
  "info": {
    "name": "TaskFlow API (jOOQ)",
    "_postman_id": "f0a9f3a2-9c1a-4b9e-8a3a-taskflow-jooq",
    "description": "Flujo completo de la API de TaskFlow (Java + Spring Boot + jOOQ + MySQL). Correr la carpeta 'Flujo completo' de arriba hacia abajo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "ownerId", "value": "" },
    { "key": "assigneeId", "value": "" },
    { "key": "projectId", "value": "" },
    { "key": "taskId", "value": "" }
  ],
  "item": [
    {
      "name": "Flujo completo",
      "item": [
        {
          "name": "1. Registrar owner",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('201 creado', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('ownerId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Maria\",\"email\":\"maria@taskflow.dev\",\"password\":\"password123\"}"
            },
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] }
          }
        },
        {
          "name": "2. Registrar assignee",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('201 creado', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('assigneeId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Juan\",\"email\":\"juan@taskflow.dev\",\"password\":\"password123\"}"
            },
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] }
          }
        },
        {
          "name": "3. Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('200 ok', () => pm.response.to.have.status(200));",
                  "pm.test('devuelve token', () => pm.expect(body.token).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('token', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"maria@taskflow.dev\",\"password\":\"password123\"}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "4. Crear proyecto",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('201 creado', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('projectId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"TaskFlow\",\"description\":\"API de gestion de tareas (jOOQ)\",\"ownerId\":{{ownerId}}}"
            },
            "url": { "raw": "{{baseUrl}}/api/projects", "host": ["{{baseUrl}}"], "path": ["api", "projects"] }
          }
        },
        {
          "name": "5. Crear tarea",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('201 creado', () => pm.response.to.have.status(201));",
                  "pm.test('trae projectName y assigneeName (join)', () => {",
                  "  pm.expect(body.projectName).to.eql('TaskFlow');",
                  "  pm.expect(body.assigneeName).to.eql('Juan');",
                  "});",
                  "pm.collectionVariables.set('taskId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Escribir README\",\"description\":\"detalle\",\"projectId\":{{projectId}},\"assigneeId\":{{assigneeId}},\"dueDate\":\"2026-12-01\"}"
            },
            "url": { "raw": "{{baseUrl}}/api/tasks", "host": ["{{baseUrl}}"], "path": ["api", "tasks"] }
          }
        },
        {
          "name": "6. Get tarea por id",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 ok', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/tasks/{{taskId}}", "host": ["{{baseUrl}}"], "path": ["api", "tasks", "{{taskId}}"] }
          }
        },
        {
          "name": "7. Cambiar status a IN_PROGRESS",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('200 ok', () => pm.response.to.have.status(200));",
                  "pm.test('status actualizado', () => pm.expect(body.status).to.eql('IN_PROGRESS'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"status\":\"IN_PROGRESS\"}" },
            "url": { "raw": "{{baseUrl}}/api/tasks/{{taskId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "tasks", "{{taskId}}", "status"] }
          }
        },
        {
          "name": "8. Listar tareas filtradas (projectId + status)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('200 ok', () => pm.response.to.have.status(200));",
                  "pm.test('al menos una tarea', () => pm.expect(body.length).to.be.above(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tasks?projectId={{projectId}}&status=IN_PROGRESS",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"],
              "query": [
                { "key": "projectId", "value": "{{projectId}}" },
                { "key": "status", "value": "IN_PROGRESS" }
              ]
            }
          }
        },
        {
          "name": "9. Reporte: tareas por status agrupadas por proyecto",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 ok', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/projects/task-status-summary", "host": ["{{baseUrl}}"], "path": ["api", "projects", "task-status-summary"] }
          }
        },
        {
          "name": "10. Borrar tarea",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('204 sin contenido', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/api/tasks/{{taskId}}", "host": ["{{baseUrl}}"], "path": ["api", "tasks", "{{taskId}}"] }
          }
        }
      ]
    },
    {
      "name": "Casos de error",
      "item": [
        {
          "name": "Crear proyecto sin token -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [ "pm.test('401 unauthorized', () => pm.response.to.have.status(401));" ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\"name\":\"x\",\"ownerId\":1}" },
            "url": { "raw": "{{baseUrl}}/api/projects", "host": ["{{baseUrl}}"], "path": ["api", "projects"] }
          }
        },
        {
          "name": "Get proyecto inexistente -> 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [ "pm.test('404 not found', () => pm.response.to.have.status(404));" ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/projects/999999", "host": ["{{baseUrl}}"], "path": ["api", "projects", "999999"] }
          }
        },
        {
          "name": "Registrar email duplicado -> 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [ "pm.test('409 conflict', () => pm.response.to.have.status(409));" ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Otra\",\"email\":\"maria@taskflow.dev\",\"password\":\"password123\"}"
            },
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] }
          }
        }
      ]
    }
  ]
}
